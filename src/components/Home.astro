---
import Base from '../layouts/Base.astro';
import Logo from './Logo.astro';
import { dict, langs, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict[lang];
const locale = langs.find((l) => l.code === lang)!.locale;

const times: string[] = [];
for (let m = 8 * 60; m <= 22 * 60; m += 30) {
  times.push(`${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`);
}
const guestOptions = Array.from({ length: 12 }, (_, i) => i + 1);

const events = t.program.events.map((e) => {
  const d = new Date(`${e.date}T12:00:00Z`);
  return {
    ...e,
    day: new Intl.DateTimeFormat(locale, { day: 'numeric', timeZone: 'UTC' }).format(d),
    month: new Intl.DateTimeFormat(locale, { month: 'long', timeZone: 'UTC' }).format(d),
    weekday: new Intl.DateTimeFormat(locale, { weekday: 'long', timeZone: 'UTC' }).format(d),
  };
});

const strings = {
  locale,
  errName: t.booking.errName,
  errContact: t.booking.errContact,
  errDate: t.booking.errDate,
  units: t.booking.guestsUnit,
  eventNote: t.booking.eventNote,
};
---
<Base lang={lang} title={t.htmlTitle} description={t.description}>
  <a class="skip" href="#booking">{t.cta}</a>

  <header class="site-header">
    <div class="wrap header-row">
      <a class="brand" href={langs.find((l) => l.code === lang)!.href} aria-label="ANSO Café">
        <Logo class="brand-logo" />
      </a>

      <nav class="nav" aria-label="ANSO Café">
        <a href="#hours">{t.nav.hours}</a>
        <a href="#program">{t.nav.program}</a>
        <a href="#booking">{t.nav.booking}</a>
        <a href="#contact">{t.nav.contact}</a>
      </nav>

      <div class="header-tools">
        <div class="mode" role="group" aria-label={t.mode.label}>
          <button type="button" class="mode-btn" data-mode="light" aria-pressed="false">{t.mode.day}</button>
          <button type="button" class="mode-btn" data-mode="dark" aria-pressed="false">{t.mode.evening}</button>
        </div>
        <ul class="langs" aria-label="Language">
          {langs.map((l) => (
            <li><a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
        <a class="btn btn-small header-cta" href="#booking">{t.cta}</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title" class="hero-title">
            <span class="only-day">{t.hero.day[0]} <em>{t.hero.day[1]}</em></span>
            <span class="only-evening">{t.hero.evening[0]} <em>{t.hero.evening[1]}</em></span>
          </h1>
          <p class="hero-lead">{t.hero.lead}</p>
        </div>

        <div class="towers" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>

        <form class="quick" id="quick" novalidate>
          <h2 class="quick-title">{t.quick.title}</h2>
          <div class="cells">
            <label class="cell cell-wide">
              <span class="cell-label">{t.quick.date}</span>
              <input type="date" id="quick-date" name="date" />
            </label>
            <label class="cell">
              <span class="cell-label">{t.quick.time}</span>
              <select id="quick-time" name="time">
                {times.map((v) => <option value={v} selected={v === '17:00'}>{v}</option>)}
              </select>
            </label>
            <label class="cell">
              <span class="cell-label">{t.quick.guests}</span>
              <select id="quick-guests" name="guests">
                {guestOptions.map((n) => <option value={n} selected={n === 2}>{n}</option>)}
              </select>
            </label>
          </div>
          <button class="btn btn-block" type="submit">
            {t.quick.next}
            <svg class="arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
          </button>
        </form>
      </div>
    </section>

    <section class="hours" id="hours" aria-labelledby="hours-title">
      <div class="wrap">
        <h2 class="section-title" id="hours-title">{t.hours.title}</h2>
        <div class="halves">
          {[
            { key: 'light', d: t.hours.day },
            { key: 'dark', d: t.hours.evening },
          ].map(({ key, d }) => (
            <article class="half" data-half={key}>
              <h3 class="half-name">{d.name}</h3>
              <p class="half-items">{d.items.join(' · ')}</p>
              <p class="half-text">{d.text}</p>
              <button type="button" class="half-switch mode-btn" data-mode={key} aria-pressed="false">
                {t.hours.switchTo} <span>{d.name.toLowerCase()}</span>
              </button>
            </article>
          ))}
        </div>
        <p class="pending">{t.hours.pending}</p>
      </div>
    </section>

    <section class="program" id="program" aria-labelledby="program-title">
      <div class="wrap">
        <div class="section-head">
          <h2 class="section-title" id="program-title">{t.program.title}</h2>
          <p class="sample-note">{t.program.sample}</p>
        </div>
        <ol class="events">
          {events.map((e) => (
            <li class="event">
              <p class="event-date">
                <span class="event-day">{e.day}</span>
                <span class="event-month">{e.month}<br />{e.weekday}</span>
              </p>
              <div class="event-body">
                <h3 class="event-title">{e.title}</h3>
                <p class="event-text">{e.text}</p>
              </div>
              <p class="event-time"><time datetime={`${e.date}T${e.time}`}>{e.time}</time></p>
              <button type="button" class="link-btn event-reserve" data-date={e.date} data-time={e.time} data-title={e.title}>
                {t.program.reserve}
                <svg class="arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
              </button>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="booking" id="booking" aria-labelledby="booking-title">
      <div class="wrap booking-grid">
        <div class="booking-intro">
          <h2 class="section-title" id="booking-title">{t.booking.title}</h2>
          <p class="booking-text">{t.booking.text}</p>
          <p class="booking-demo">{t.booking.demo}</p>
        </div>

        <div class="booking-panel">
          <form class="book" id="book" novalidate>
            <div class="cells cells-book">
              <label class="cell cell-wide" for="b-name">
                <span class="cell-label">{t.booking.name}</span>
                <input id="b-name" name="name" type="text" autocomplete="name" aria-describedby="b-name-err" />
                <span class="cell-error" id="b-name-err" hidden></span>
              </label>
              <label class="cell cell-wide" for="b-contact">
                <span class="cell-label">{t.booking.contact}</span>
                <input id="b-contact" name="contact" type="text" autocomplete="email" aria-describedby="b-contact-hint b-contact-err" />
                <span class="cell-hint" id="b-contact-hint">{t.booking.contactHint}</span>
                <span class="cell-error" id="b-contact-err" hidden></span>
              </label>
              <label class="cell" for="b-date">
                <span class="cell-label">{t.booking.date}</span>
                <input id="b-date" name="date" type="date" aria-describedby="b-date-err" />
                <span class="cell-error" id="b-date-err" hidden></span>
              </label>
              <label class="cell" for="b-time">
                <span class="cell-label">{t.booking.time}</span>
                <select id="b-time" name="time">
                  {times.map((v) => <option value={v} selected={v === '17:00'}>{v}</option>)}
                </select>
              </label>
              <div class="cell cell-wide stepper-cell">
                <span class="cell-label" id="b-guests-label">{t.booking.guests}</span>
                <div class="stepper">
                  <button type="button" class="step" data-step="-1" aria-label={t.booking.less}>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12" /></svg>
                  </button>
                  <output id="b-guests" aria-labelledby="b-guests-label" aria-live="polite">2</output>
                  <button type="button" class="step" data-step="1" aria-label={t.booking.more}>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M10 4v12" /></svg>
                  </button>
                </div>
              </div>
              <label class="cell cell-wide" for="b-note">
                <span class="cell-label">{t.booking.note}</span>
                <textarea id="b-note" name="note" rows="2" placeholder={t.booking.notePlaceholder}></textarea>
              </label>
            </div>
            <button class="btn btn-block" type="submit">
              {t.booking.submit}
              <svg class="arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
            </button>
          </form>

          <div class="done" id="done" hidden tabindex="-1">
            <h3 class="done-title">{t.booking.doneTitle}</h3>
            <p class="done-summary" id="done-summary"></p>
            <p class="done-text">{t.booking.doneText}</p>
            <button type="button" class="link-btn" id="again">{t.booking.again}</button>
          </div>
        </div>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="wrap">
        <h2 class="section-title" id="contact-title">{t.contact.title}</h2>
        <dl class="facts">
          {[t.contact.address, t.contact.open, t.contact.reach, t.contact.social].map((label) => (
            <div class="fact">
              <dt>{label}</dt>
              <dd>{t.contact.pending}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <Logo class="footer-logo" />
      <p class="footer-line">{t.footer}</p>
      <ul class="langs langs-footer" aria-label="Language">
        {langs.map((l) => (
          <li><a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <p class="copy">© 2026 ANSO Café</p>
    </div>
  </footer>

  <script is:inline define:vars={{ strings }}>
    (function () {
      var root = document.documentElement;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      function syncMode() {
        var mode = root.getAttribute('data-theme');
        document.querySelectorAll('.mode-btn').forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.getAttribute('data-mode') === mode));
        });
        document.querySelectorAll('.half').forEach(function (h) {
          h.classList.toggle('is-active', h.getAttribute('data-half') === mode);
        });
      }

      function setMode(mode, x, y) {
        if (root.getAttribute('data-theme') === mode) return;
        try { localStorage.setItem('anso-mode', mode); } catch (e) {}
        var apply = function () { root.setAttribute('data-theme', mode); syncMode(); };
        if (!document.startViewTransition || reduce.matches) { apply(); return; }
        var r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        var vt = document.startViewTransition(apply);
        vt.ready.then(function () {
          root.animate(
            { clipPath: ['circle(0px at ' + x + 'px ' + y + 'px)', 'circle(' + r + 'px at ' + x + 'px ' + y + 'px)'] },
            { duration: 750, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', pseudoElement: '::view-transition-new(root)' }
          );
        }).catch(function () {});
      }

      document.querySelectorAll('.mode-btn').forEach(function (b) {
        b.addEventListener('click', function () {
          var box = b.getBoundingClientRect();
          setMode(b.getAttribute('data-mode'), box.left + box.width / 2, box.top + box.height / 2);
        });
      });
      syncMode();

      // Dates: today in Prague is the earliest bookable day.
      var today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Prague' }).format(new Date());
      var quickDate = document.getElementById('quick-date');
      var bDate = document.getElementById('b-date');
      [quickDate, bDate].forEach(function (el) { el.min = today; el.value = today; });

      var guests = 2;
      var out = document.getElementById('b-guests');
      function setGuests(n) { guests = Math.min(12, Math.max(1, n)); out.textContent = String(guests); }
      document.querySelectorAll('.step').forEach(function (b) {
        b.addEventListener('click', function () { setGuests(guests + Number(b.getAttribute('data-step'))); });
      });

      var name = document.getElementById('b-name');
      var bTime = document.getElementById('b-time');
      var note = document.getElementById('b-note');

      function goToForm() {
        document.getElementById('booking').scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'start' });
        name.focus({ preventScroll: true });
      }

      document.getElementById('quick').addEventListener('submit', function (e) {
        e.preventDefault();
        bDate.value = quickDate.value || today;
        bTime.value = document.getElementById('quick-time').value;
        setGuests(Number(document.getElementById('quick-guests').value));
        goToForm();
      });

      document.querySelectorAll('.event-reserve').forEach(function (b) {
        b.addEventListener('click', function () {
          bDate.value = b.getAttribute('data-date');
          bTime.value = b.getAttribute('data-time');
          note.value = strings.eventNote + ': ' + b.getAttribute('data-title');
          goToForm();
        });
      });

      function showError(input, msg) {
        var err = document.getElementById(input.id + '-err');
        err.textContent = msg || '';
        err.hidden = !msg;
        input.setAttribute('aria-invalid', msg ? 'true' : 'false');
        input.closest('.cell').classList.toggle('has-error', !!msg);
      }

      var form = document.getElementById('book');
      var done = document.getElementById('done');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var contact = document.getElementById('b-contact');
        var bad = [];
        showError(name, name.value.trim() ? '' : strings.errName);
        if (!name.value.trim()) bad.push(name);
        var c = contact.value.trim();
        var okContact = /\S+@\S+\.\S+/.test(c) || c.replace(/[^\d]/g, '').length >= 9;
        showError(contact, okContact ? '' : strings.errContact);
        if (!okContact) bad.push(contact);
        var okDate = bDate.value && bDate.value >= today;
        showError(bDate, okDate ? '' : strings.errDate);
        if (!okDate) bad.push(bDate);
        if (bad.length) { bad[0].focus(); return; }

        var d = new Date(bDate.value + 'T12:00:00Z');
        var when = new Intl.DateTimeFormat(strings.locale, { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }).format(d);
        var unit = strings.units[guests === 1 ? 0 : guests <= 4 ? 1 : 2];
        document.getElementById('done-summary').textContent =
          name.value.trim() + ', ' + when + ', ' + bTime.value + ', ' + guests + ' ' + unit;
        form.hidden = true;
        done.hidden = false;
        done.focus();
      });

      document.getElementById('again').addEventListener('click', function () {
        form.reset();
        bDate.value = today;
        setGuests(2);
        done.hidden = true;
        form.hidden = false;
        name.focus();
      });
    })();
  </script>
</Base>

<style is:global>
  /* Logo-grid facade: 1px frames like the boxed A N S O letters, tower rules, square corners.
     Day = lichen ground, Evening = graphite ground; blueberry is the only signal colour. */
  :root {
    --bg: #E7E3DE;
    --surface: #F4F2EF;
    --ink: #16191B;
    --muted: #5E6468;
    --line: #25292C;
    --line-soft: rgba(37, 41, 44, 0.16);
    --accent: #4467A6;
    --accent-hover: #34528A;
    --accent-ink: #34528A;
    --on-accent: #F4F2EF;
    --band: #7D8C6F;
    --on-band: #16191B;
    --band-line: rgba(22, 25, 27, 0.55);
    --error: #A3322A;
    --foot: #231F20;
    --on-foot: #F4F2EF;
    --on-foot-muted: #B9BEC1;
    --logo-script: #34528A;

    --f-display: 'Space Grotesk', 'Helvetica Neue', Arial, sans-serif;
    --f-accent: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --f-body: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;

    --t-h1: clamp(2.6rem, 6.4vw, 5.75rem);
    --t-h2: clamp(2rem, 4.2vw, 3.25rem);
    --t-h3: 1.375rem;
    --t-body: 1rem;
    --t-small: 0.8125rem;

    --gutter: max(clamp(16px, 5vw, 64px), env(safe-area-inset-left, 0px));
    --gutter-r: max(clamp(16px, 5vw, 64px), env(safe-area-inset-right, 0px));
    --section-y: clamp(72px, 10vw, 136px);
    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #2B3237;
      --surface: #363F45;
      --ink: #F4F2EF;
      --muted: #B9BEC1;
      --line: #F4F2EF;
      --line-soft: rgba(244, 242, 239, 0.18);
      --accent: #9DB4DE;
      --accent-hover: #B7C9E8;
      --accent-ink: #9DB4DE;
      --on-accent: #231F20;
      --band: #4A5541;
      --on-band: #F4F2EF;
      --band-line: rgba(244, 242, 239, 0.4);
      --error: #F0A59B;
      --logo-script: #9DB4DE;
      color-scheme: dark;
    }
  }

  :root[data-theme="dark"] {
    --bg: #2B3237;
    --surface: #363F45;
    --ink: #F4F2EF;
    --muted: #B9BEC1;
    --line: #F4F2EF;
    --line-soft: rgba(244, 242, 239, 0.18);
    --accent: #9DB4DE;
    --accent-hover: #B7C9E8;
    --accent-ink: #9DB4DE;
    --on-accent: #231F20;
    --band: #4A5541;
    --on-band: #F4F2EF;
    --band-line: rgba(244, 242, 239, 0.4);
    --error: #F0A59B;
    --logo-script: #9DB4DE;
    color-scheme: dark;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html { scroll-padding-top: calc(env(safe-area-inset-top, 0px) + 88px); scrollbar-color: var(--muted) var(--bg); }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 400 var(--t-body)/1.6 var(--f-body);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  ::selection { background: var(--accent); color: var(--on-accent); }

  :focus-visible { outline: 2px solid var(--accent-ink); outline-offset: 3px; }

  h1, h2, h3 { margin: 0; font-family: var(--f-display); font-weight: 400; text-wrap: balance; }
  p { margin: 0; }
  a { color: inherit; text-underline-offset: 0.25em; text-decoration-thickness: 1px; }
  button, input, select, textarea { font: inherit; color: inherit; }
  button { cursor: pointer; }

  .wrap {
    width: 100%;
    max-width: calc(1240px + 2 * clamp(16px, 5vw, 64px));
    margin-inline: auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter-r);
  }

  .skip {
    position: absolute;
    left: 16px;
    top: -100px;
    z-index: 20;
    background: var(--accent);
    color: var(--on-accent);
    padding: 10px 16px;
  }
  .skip:focus { top: calc(env(safe-area-inset-top, 0px) + 12px); }

  [hidden] { display: none !important; }
  :root:not([data-theme="dark"]) .only-evening, :root[data-theme="dark"] .only-day { display: none !important; }

  /* ---------- Buttons ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 24px;
    border: 0;
    background: var(--accent);
    color: var(--on-accent);
    font: 500 0.875rem/1 var(--f-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 200ms ease;
  }
  .btn:hover { background: var(--accent-hover); }
  .btn-small { min-height: 40px; padding: 0 16px; font-size: 0.75rem; }
  .btn-block { width: 100%; justify-content: space-between; }

  .arrow { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.5; transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1); }
  .btn:hover .arrow, .link-btn:hover .arrow { transform: translateX(4px); }

  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent-ink);
    font: 500 0.875rem/1.3 var(--f-display);
    letter-spacing: 0.04em;
    text-align: left;
  }
  .link-btn:hover { text-decoration: underline; text-underline-offset: 0.3em; }

  /* ---------- Header ---------- */
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .header-row { display: flex; align-items: center; gap: 24px; min-height: 76px; }
  .brand { color: var(--ink); flex: none; }
  .brand-logo { width: 96px; }
  .nav { display: flex; gap: 28px; margin-inline: auto; font: 400 0.875rem/1 var(--f-display); letter-spacing: 0.02em; }
  .nav a { text-decoration: none; padding-block: 8px; border-bottom: 1px solid transparent; }
  .nav a:hover { border-bottom-color: currentColor; }
  .header-tools { display: flex; align-items: center; gap: 16px; }

  .mode { display: inline-flex; border: 1px solid var(--line); }
  .mode .mode-btn {
    min-height: 40px;
    padding: 0 14px;
    border: 0;
    background: transparent;
    font: 500 0.75rem/1 var(--f-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .mode .mode-btn + .mode-btn { border-left: 1px solid var(--line); }
  .mode .mode-btn[aria-pressed="true"] { background: var(--ink); color: var(--bg); }

  .langs { display: flex; gap: 2px; margin: 0; padding: 0; list-style: none; font: 500 0.75rem/1 var(--f-display); letter-spacing: 0.08em; }
  .langs a { display: inline-block; padding: 8px 6px; text-decoration: none; color: var(--muted); }
  .langs a:hover { color: var(--ink); }
  .langs a[aria-current="page"] { color: var(--ink); text-decoration: underline; text-underline-offset: 6px; }

  /* ---------- Hero ---------- */
  .hero { border-bottom: 1px solid var(--line); overflow: hidden; }
  .hero-grid {
    display: grid;
