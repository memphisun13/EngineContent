---
import Base from '../layouts/Base.astro';
import Logo from './Logo.astro';
import { dict, langs, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict[lang];
const current = langs.find((l) => l.code === lang)!;
const locale = current.locale;

const times: string[] = [];
for (let m = 8 * 60; m <= 22 * 60; m += 30) {
  times.push(`${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`);
}

const events = t.program.events.map((e) => {
  const d = new Date(`${e.date}T12:00:00Z`);
  const f = (o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat(locale, { ...o, timeZone: 'UTC' }).format(d);
  return { ...e, day: f({ day: 'numeric' }), month: f({ month: 'long' }), weekday: f({ weekday: 'long' }) };
});

const strings = {
  locale,
  errName: t.booking.errName,
  errContact: t.booking.errContact,
  errDate: t.booking.errDate,
  units: t.booking.guestsUnit,
  eventNote: t.booking.eventNote,
};

const arrow = 'M3 10h13M11 5l5 5-5 5';
---
<Base lang={lang} title={t.htmlTitle} description={t.description}>
  <a class="skip" href="#booking">{t.cta}</a>

  <header class="site-header">
    <div class="header-row">
      <nav class="nav" aria-label="ANSO Café">
        <a href="#program">{t.nav.program}</a>
        <a href="#hours">{t.nav.hours}</a>
        <a href="#booking">{t.nav.booking}</a>
        <a href="#contact">{t.nav.contact}</a>
      </nav>

      <a class="brand" href={current.href} aria-label="ANSO Café">
        <Logo class="brand-logo" />
      </a>

      <div class="header-tools">
        <div class="mode" role="group" aria-label={t.mode.label}>
          <button type="button" class="mode-btn" data-mode="light" aria-pressed="false">{t.mode.day}</button>
          <button type="button" class="mode-btn" data-mode="dark" aria-pressed="false">{t.mode.evening}</button>
        </div>
        <ul class="langs" aria-label="Language">
          {langs.map((l) => (
            <li><a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap">
        <div class="hero-stage">
          <Logo class="hero-logo" />
        </div>
        <div class="hero-text">
          <h1 id="hero-title" class="hero-title">
            <span class="only-day">{t.hero.day[0]} <em>{t.hero.day[1]}</em></span>
            <span class="only-evening">{t.hero.evening[0]} <em>{t.hero.evening[1]}</em></span>
          </h1>
          <p class="hero-lead">{t.hero.lead}</p>
          <a class="btn" href="#booking">{t.cta}</a>
        </div>
      </div>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[0, 1].map(() => (
          <ul class="marquee-list">
            {t.marquee.map((m) => (
              <li>
                <svg class="tower-ico" viewBox="0 0 20 20"><path d="M6 18V7h3V3h3v4h3v11M9 7v11M12 7v11" /></svg>
                {m}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>

    <section class="program" id="program" aria-labelledby="program-title">
      <div class="wrap">
        <div class="center-head">
          <h2 class="section-title" id="program-title">{t.program.title}</h2>
          <p class="section-lead">{t.program.lead}</p>
        </div>
      </div>

      <div class="carousel">
        <ol class="cards" id="cards" tabindex="0" aria-label={t.program.title}>
          {events.map((e) => (
            <li class="card">
              <div class="card-face">
                <p class="card-day">{e.day}</p>
                <p class="card-month">{e.month}</p>
                <p class="card-weekday">{e.weekday} · <time datetime={`${e.date}T${e.time}`}>{e.time}</time></p>
              </div>
              <div class="card-body">
                <h3 class="card-title">{e.title}</h3>
                <p class="card-text">{e.text}</p>
                <button type="button" class="btn btn-outline event-reserve" data-date={e.date} data-time={e.time} data-title={e.title}>
                  {t.program.reserve}
                </button>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="wrap carousel-foot">
        <p class="sample-note">{t.program.sample}</p>
        <div class="arrows">
          <button type="button" class="round" data-dir="-1" aria-label={t.program.prev} aria-controls="cards">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M17 10H4M9 5l-5 5 5 5" /></svg>
          </button>
          <button type="button" class="round" data-dir="1" aria-label={t.program.next} aria-controls="cards">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrow} /></svg>
          </button>
        </div>
      </div>
    </section>

    <section class="feature" id="hours" aria-labelledby="hours-title">
      <div class="wrap feature-grid">
        <div class="feature-stage" aria-hidden="true">
          <p class="feature-word only-day">{t.hours.day.name}</p>
          <p class="feature-word only-evening">{t.hours.evening.name}</p>
          <p class="feature-tag">{t.feature.now}</p>
        </div>
        <div class="feature-copy">
          <h2 class="feature-title" id="hours-title">{t.hours.title}</h2>
          <p class="section-lead feature-lead">{t.feature.lead}</p>
          <div class="pills" role="group" aria-label={t.mode.label}>
            <button type="button" class="pill mode-btn" data-mode="light" aria-pressed="false">{t.hours.day.name}</button>
            <button type="button" class="pill mode-btn" data-mode="dark" aria-pressed="false">{t.hours.evening.name}</button>
          </div>
          <dl class="moods">
            <div class="mood" data-half="light">
              <dt>{t.hours.day.name} · {t.hours.day.items.join(', ')}</dt>
              <dd>{t.hours.day.text}</dd>
            </div>
            <div class="mood" data-half="dark">
              <dt>{t.hours.evening.name} · {t.hours.evening.items.join(', ')}</dt>
              <dd>{t.hours.evening.text}</dd>
            </div>
          </dl>
          <p class="note">{t.hours.pending}</p>
        </div>
      </div>
    </section>

    <section class="booking" id="booking" aria-labelledby="booking-title">
      <div class="wrap">
        <div class="booking-card">
          <h2 class="section-title" id="booking-title">{t.booking.title}</h2>
          <p class="section-lead">{t.booking.text}</p>
          <p class="note">{t.booking.demo}</p>

          <form class="book" id="book" novalidate>
            <div class="field field-wide">
              <label for="b-name">{t.booking.name}</label>
              <input id="b-name" name="name" type="text" autocomplete="name" aria-describedby="b-name-err" />
              <span class="field-error" id="b-name-err" hidden></span>
            </div>
            <div class="field field-wide">
              <label for="b-contact">{t.booking.contact}</label>
              <input id="b-contact" name="contact" type="text" autocomplete="email" placeholder={t.booking.contactHint} aria-describedby="b-contact-err" />
              <span class="field-error" id="b-contact-err" hidden></span>
            </div>
            <div class="field">
              <label for="b-date">{t.booking.date}</label>
              <input id="b-date" name="date" type="date" aria-describedby="b-date-err" />
              <span class="field-error" id="b-date-err" hidden></span>
            </div>
            <div class="field">
              <label for="b-time">{t.booking.time}</label>
              <select id="b-time" name="time">
                {times.map((v) => <option value={v} selected={v === '17:00'}>{v}</option>)}
              </select>
            </div>
            <div class="field field-wide field-row">
              <span class="label" id="b-guests-label">{t.booking.guests}</span>
              <div class="stepper">
                <button type="button" class="step" data-step="-1" aria-label={t.booking.less}>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12" /></svg>
                </button>
                <output id="b-guests" aria-labelledby="b-guests-label" aria-live="polite">2</output>
                <button type="button" class="step" data-step="1" aria-label={t.booking.more}>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M10 4v12" /></svg>
                </button>
              </div>
            </div>
            <div class="field field-wide">
              <label for="b-note">{t.booking.note}</label>
              <textarea id="b-note" name="note" rows="2" placeholder={t.booking.notePlaceholder}></textarea>
            </div>
            <button class="btn btn-block" type="submit">{t.booking.submit}</button>
          </form>

          <div class="done" id="done" hidden tabindex="-1">
            <h3 class="done-title">{t.booking.doneTitle}</h3>
            <p class="done-summary" id="done-summary"></p>
            <p class="section-lead">{t.booking.doneText}</p>
            <button type="button" class="btn btn-outline" id="again">{t.booking.again}</button>
          </div>
        </div>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="wrap">
        <h2 class="section-title center" id="contact-title">{t.contact.title}</h2>
        <dl class="facts">
          {[t.contact.address, t.contact.open, t.contact.reach, t.contact.social].map((label) => (
            <div class="fact">
              <dt>{label}</dt>
              <dd>{t.contact.pending}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-skyline" aria-hidden="true"><Logo class="skyline-logo" /></div>
    <div class="wrap footer-grid">
      <p class="footer-about">{t.description}</p>
      <ul class="footer-links">
        <li><a href="#program">{t.nav.program}</a></li>
        <li><a href="#hours">{t.nav.hours}</a></li>
        <li><a href="#booking">{t.nav.booking}</a></li>
        <li><a href="#contact">{t.nav.contact}</a></li>
      </ul>
      <div class="footer-cta">
        <p class="footer-title">{t.footer}</p>
        <a class="btn btn-light" href="#booking">{t.cta}</a>
      </div>
      <div class="footer-bottom">
        <p>© 2026 ANSO Café</p>
        <ul class="langs" aria-label="Language">
          {langs.map((l) => (
            <li><a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </footer>

  <script is:inline define:vars={{ strings }}>
    (function () {
      var root = document.documentElement;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      function syncMode() {
        var mode = root.getAttribute('data-theme');
        document.querySelectorAll('.mode-btn').forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.getAttribute('data-mode') === mode));
        });
        document.querySelectorAll('.mood').forEach(function (m) {
          m.classList.toggle('is-active', m.getAttribute('data-half') === mode);
        });
      }

      function setMode(mode, x, y) {
        if (root.getAttribute('data-theme') === mode) return;
        try { localStorage.setItem('anso-mode', mode); } catch (e) {}
        var apply = function () { root.setAttribute('data-theme', mode); syncMode(); };
        if (!document.startViewTransition || reduce.matches) { apply(); return; }
        var r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        var vt = document.startViewTransition(apply);
        vt.ready.then(function () {
          root.animate(
            { clipPath: ['circle(0px at ' + x + 'px ' + y + 'px)', 'circle(' + r + 'px at ' + x + 'px ' + y + 'px)'] },
            { duration: 750, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', pseudoElement: '::view-transition-new(root)' }
          );
        }).catch(function () {});
      }

      document.querySelectorAll('.mode-btn').forEach(function (b) {
        b.addEventListener('click', function () {
          var box = b.getBoundingClientRect();
          setMode(b.getAttribute('data-mode'), box.left + box.width / 2, box.top + box.height / 2);
        });
      });
      syncMode();

      // Carousel arrows scroll by one card.
      var cards = document.getElementById('cards');
      document.querySelectorAll('.round').forEach(function (b) {
        b.addEventListener('click', function () {
          var card = cards.querySelector('.card');
          var step = card ? card.getBoundingClientRect().width + 24 : 320;
          cards.scrollBy({ left: step * Number(b.getAttribute('data-dir')), behavior: reduce.matches ? 'auto' : 'smooth' });
        });
      });

      var today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Prague' }).format(new Date());
      var bDate = document.getElementById('b-date');
      bDate.min = today;
      bDate.value = today;

      var guests = 2;
      var out = document.getElementById('b-guests');
      function setGuests(n) { guests = Math.min(12, Math.max(1, n)); out.textContent = String(guests); }
      document.querySelectorAll('.step').forEach(function (b) {
        b.addEventListener('click', function () { setGuests(guests + Number(b.getAttribute('data-step'))); });
      });

      var name = document.getElementById('b-name');
      var bTime = document.getElementById('b-time');
      var note = document.getElementById('b-note');

      document.querySelectorAll('.event-reserve').forEach(function (b) {
        b.addEventListener('click', function () {
          bDate.value = b.getAttribute('data-date');
          bTime.value = b.getAttribute('data-time');
          note.value = strings.eventNote + ': ' + b.getAttribute('data-title');
          document.getElementById('booking').scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'start' });
          name.focus({ preventScroll: true });
        });
      });

      function showError(input, msg) {
        var err = document.getElementById(input.id + '-err');
        err.textContent = msg || '';
        err.hidden = !msg;
        input.setAttribute('aria-invalid', msg ? 'true' : 'false');
      }

      var form = document.getElementById('book');
      var done = document.getElementById('done');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var contact = document.getElementById('b-contact');
        var bad = [];
        var okName = !!name.value.trim();
        showError(name, okName ? '' : strings.errName);
        if (!okName) bad.push(name);
        var c = contact.value.trim();
        var okContact = /\S+@\S+\.\S+/.test(c) || c.replace(/[^\d]/g, '').length >= 9;
        showError(contact, okContact ? '' : strings.errContact);
        if (!okContact) bad.push(contact);
        var okDate = bDate.value && bDate.value >= today;
        showError(bDate, okDate ? '' : strings.errDate);
        if (!okDate) bad.push(bDate);
        if (bad.length) { bad[0].focus(); return; }

        var d = new Date(bDate.value + 'T12:00:00Z');
        var when = new Intl.DateTimeFormat(strings.locale, { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }).format(d);
        var unit = strings.units[guests === 1 ? 0 : guests <= 4 ? 1 : 2];
        document.getElementById('done-summary').textContent =
          name.value.trim() + ', ' + when + ', ' + bTime.value + ', ' + guests + ' ' + unit;
        form.hidden = true;
        done.hidden = false;
        done.focus();
      });

      document.getElementById('again').addEventListener('click', function () {
        form.reset();
        bDate.value = today;
        setGuests(2);
        done.hidden = true;
        form.hidden = false;
        name.focus();
      });
    })();
  </script>
</Base>

<style is:global>
  /* Soft café storefront: light lichen ground, rounded panels, centred serif titles, pill controls.
     Blueberry is the only signal colour; the logo's towers stand on the black footer. */
  :root {
    --bg: #F4F2EF;
    --panel: #E7E3DE;
    --panel-2: #DCD7D0;
    --ink: #25292C;
    --muted: #5E6468;
    --line: rgba(37, 41, 44, 0.4);
    --line-soft: rgba(37, 41, 44, 0.12);
    --accent: #4467A6;
    --accent-hover: #34528A;
    --accent-ink: #34528A;
    --on-accent: #F4F2EF;
    --stage: #4467A6;
    --error: #A3322A;
    --foot: #231F20;
    --on-foot: #F4F2EF;
    --on-foot-muted: #B9BEC1;

    --f-display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --f-body: 'Manrope', 'Helvetica Neue', Arial, sans-serif;

    --r-lg: 20px;
    --r-md: 14px;
    --gutter: max(clamp(16px, 2.5vw, 36px), env(safe-area-inset-left, 0px));
    --gutter-r: max(clamp(16px, 2.5vw, 36px), env(safe-area-inset-right, 0px));
    --section-y: clamp(64px, 8vw, 112px);
    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #2B3237;
      --panel: #363F45;
      --panel-2: #414B52;
      --ink: #F4F2EF;
      --muted: #B9BEC1;
      --line: rgba(244, 242, 239, 0.4);
      --line-soft: rgba(244, 242, 239, 0.14);
      --accent: #9DB4DE;
      --accent-hover: #B7C9E8;
      --accent-ink: #9DB4DE;
      --on-accent: #231F20;
      --stage: #2F4A7E;
      --error: #F0A59B;
      color-scheme: dark;
    }
  }

  :root[data-theme="dark"] {
    --bg: #2B3237;
    --panel: #363F45;
    --panel-2: #414B52;
    --ink: #F4F2EF;
    --muted: #B9BEC1;
    --line: rgba(244, 242, 239, 0.4);
    --line-soft: rgba(244, 242, 239, 0.14);
    --accent: #9DB4DE;
    --accent-hover: #B7C9E8;
    --accent-ink: #9DB4DE;
    --on-accent: #231F20;
    --stage: #2F4A7E;
    --error: #F0A59B;
    color-scheme: dark;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-padding-top: calc(env(safe-area-inset-top, 0px) + 96px); scrollbar-color: var(--muted) var(--bg); }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 400 1rem/1.6 var(--f-body);
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: var(--accent); color: var(--on-accent); }
  :focus-visible { outline: 2px solid var(--accent-ink); outline-offset: 3px; }
  [hidden] { display: none !important; }
  h1, h2, h3, p { margin: 0; }
  h1, h2, h3 { font-family: var(--f-display); font-weight: 500; text-wrap: balance; }
  a { color: inherit; text-underline-offset: 0.25em; text-decoration-thickness: 1px; }
  button, input, select, textarea { font: inherit; color: inherit; }
  button { cursor: pointer; }

  :root:not([data-theme="dark"]) .only-evening, :root[data-theme="dark"] .only-day { display: none !important; }

  .wrap {
    width: 100%;
    max-width: calc(1360px + 2 * clamp(16px, 2.5vw, 36px));
    margin-inline: auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter-r);
  }

  .skip { position: absolute; left: 16px; top: -100px; z-index: 20; background: var(--accent); color: var(--on-accent); padding: 10px 16px; border-radius: 999px; }
  .skip:focus { top: calc(env(safe-area-inset-top, 0px) + 12px); }

  /* ---------- Buttons ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 46px;
    padding: 0 26px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font: 500 0.9375rem/1 var(--f-body);
    text-decoration: none;
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }
  .btn:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
  .btn-outline { background: transparent; color: var(--ink); border-color: var(--line); }
  .btn-outline:hover { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .btn-light { background: #F4F2EF; border-color: #F4F2EF; color: #231F20; }
  .btn-light:hover { background: #DCD7D0; border-color: #DCD7D0; }
  .btn-block { width: 100%; grid-column: 1 / -1; }

  .round {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--accent-ink);
    border-radius: 50%;
    background: transparent;
    color: var(--accent-ink);
    transition: background-color 200ms ease, color 200ms ease;
  }
  .round:hover { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
  .round svg, .step svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }

  /* ---------- Header ---------- */
  .site-header { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 10; background: var(--bg); }
  .header-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    min-height: 88px;
    padding-left: var(--gutter);
    padding-right: var(--gutter-r);
  }
  .nav { display: flex; flex-wrap: wrap; gap: 6px 26px; font: 500 0.8125rem/1 var(--f-body); letter-spacing: 0.06em; text-transform: uppercase; }
  .nav a { text-decoration: none; padding-block: 8px; }
  .nav a:hover { text-decoration: underline; }
  .brand { color: var(--ink); }
  .brand-logo { width: 88px; }
  .header-tools { display: flex; align-items: center; justify-content: flex-end; gap: 18px; }

  .mode { display: inline-flex; padding: 3px; border: 1px solid var(--line); border-radius: 999px; }
  .mode .mode-btn {
    min-height: 34px;
    padding: 0 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font: 500 0.8125rem/1 var(--f-body);
  }
  .mode .mode-btn[aria-pressed="true"] { background: var(--ink); color: var(--bg); }

  .langs { display: flex; gap: 2px; margin: 0; padding: 0; list-style: none; font: 500 0.8125rem/1 var(--f-body); letter-spacing: 0.06em; }
  .langs a { display: inline-block; padding: 8px 5px; text-decoration: none; color: var(--muted); }
  .langs a:hover, .langs a[aria-current="page"] { color: var(--ink); }
  .langs a[aria-current="page"] { text-decoration: underline; text-underline-offset: 6px; }

  /* ---------- Hero ---------- */
