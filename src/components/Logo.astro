---
// Vector traced from the designer's logo (images supplied by the owner, 2026-10-15).
import raw from '../assets/anso-logo.svg?raw';
interface Props { class?: string; title?: string }
const { class: className, title = 'ANSO Café' } = Astro.props;
const viewBox = raw.match(/viewBox="([^"]+)"/)![1];
const d = raw.match(/ d="([^"]+)"/)![1];
---
<svg class:list={['logo', className]} viewBox={viewBox} role="img" aria-label={title}>
  <path d={d} fill="currentColor" fill-rule="evenodd" stroke="currentColor" stroke-width="0.6" vector-effect="non-scaling-stroke" />
</svg>

<style>
  .logo { display: block; height: auto; }
</style>
