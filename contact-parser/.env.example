# ID Google-таблицы: часть ссылки между /d/ и /edit
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# Если оставить пустым — результат пишется в output/people.csv и output/companies.csv
SHEET_ID=

# Путь к JSON-ключу service account (относительно папки проекта или абсолютный)
GOOGLE_KEY_PATH=service_account.json

# Максимум профилей LinkedIn за один запуск
LIMIT=100

# --- необязательные настройки ---
# Случайная пауза между страницами, секунды
PAUSE_MIN=3
PAUSE_MAX=8
# Сколько компаний брать из одной ссылки на каталог dou.ua (/companies/?...)
DOU_LIST_LIMIT=50
# Папка постоянного профиля браузера (здесь хранится вход в LinkedIn)
BROWSER_PROFILE_DIR=browser_profile
# true — браузер без окна. Для LinkedIn лучше оставить false
HEADLESS=false
